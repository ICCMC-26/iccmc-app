# Cloudflare: the shell must always revalidate so a push shows up immediately.
# The assets are ?v-versioned (immutable) → cache them hard.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/ocr.html
  Cache-Control: no-cache, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
